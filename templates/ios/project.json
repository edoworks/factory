      "info": {"path": "Info.plist", "properties": {"CFBundleDisplayName": "Generated app", "UILaunchScreen": {}, "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait", "UIInterfaceOrientationLandscapeLeft", "UIInterfaceOrientationLandscapeRight"]}}
