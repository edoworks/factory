{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "{env:FACTORY_DEV_OPENCODE_ROOT}/policies/factory-progress.md",
    "{env:FACTORY_DEV_OPENCODE_ROOT}/model-routing/instructions.md"
  ],
  "plugin": [
    "{env:FACTORY_DEV_OPENCODE_ROOT}/plugins/cost-router.mjs"
  ],
  "disabled_providers": ["github-copilot"],
  "tool_output": { "max_lines": 200, "max_bytes": 8192 },
  "compaction": { "auto": true, "tail_turns": 8 },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "granite4.1:30b": { "name": "Granite 4.1 30B (local)", "tool_call": true, "limit": { "context": 131072, "output": 32768 } },
        "qwen3.5:27b": { "name": "Qwen 3.5 27B (local)", "attachment": true, "reasoning": true, "tool_call": true, "limit": { "context": 262144, "output": 65536 }, "modalities": { "input": ["text", "image"], "output": ["text"] } },
        "gemma4:12b": { "name": "Gemma 4 12B (local)", "attachment": true, "reasoning": true, "tool_call": true, "limit": { "context": 262144, "output": 65536 }, "modalities": { "input": ["text", "image"], "output": ["text"] } },
        "qwen3.5:9b": { "name": "Qwen 3.5 9B (local)", "attachment": true, "reasoning": true, "tool_call": true, "limit": { "context": 262144, "output": 65536 }, "modalities": { "input": ["text", "image"], "output": ["text"] } },
        "granite4.1:8b": { "name": "Granite 4.1 8B (local)", "tool_call": true, "limit": { "context": 131072, "output": 32768 } },
        "granite4.1:3b": { "name": "Granite 4.1 3B (local)", "tool_call": true, "limit": { "context": 131072, "output": 32768 } },
        "qwen3.5:4b": { "name": "Qwen 3.5 4B (local)", "attachment": true, "reasoning": true, "tool_call": true, "limit": { "context": 262144, "output": 65536 }, "modalities": { "input": ["text", "image"], "output": ["text"] } }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "deny",
      "git status*": "allow", "git diff*": "allow", "git log*": "allow", "git show*": "allow",
      "git add *": "allow", "git commit -m *": "allow",
      "python3 -m unittest*": "deny", "node --test*": "deny",
      "python3 -m unittest discover -s {env:FACTORY_DEV_OPENCODE_ROOT}/../../tests": "allow", "node --test {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/continuation-command.test.mjs {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/git-push.test.mjs {env:FACTORY_DEV_OPENCODE_ROOT}/plugins/cost-router.test.mjs": "allow", "{env:FACTORY_DEV_OPENCODE_ROOT}/../../bin/factory-dev doctor*": "allow",
      "node {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/issue-intent.mjs hash *": "allow", "node {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/issue-intent.mjs validate *": "allow", "node {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/issue-intent.mjs verify-remote *": "allow",
      "node {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/issue-intent.mjs create *": "ask", "node {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/issue-intent.mjs comment *": "ask", "node {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/issue-intent.mjs close *": "ask",
      "node {env:FACTORY_DEV_OPENCODE_ROOT}/scripts/git-push.mjs feature/* *": "ask",
      "python3 ~/.agents/skills/macos-screenshot/scripts/screenshot.py *": "allow",
      "{env:FACTORY_DEV_GH} issue view --repo edoworks/factory *": "allow", "{env:FACTORY_DEV_GH} issue list --repo edoworks/factory *": "allow",
      "{env:FACTORY_DEV_GH} pr view * --repo edoworks/factory *": "allow", "{env:FACTORY_DEV_GH} pr checks * --repo edoworks/factory *": "allow",
      "{env:FACTORY_DEV_GH} pr create --repo edoworks/factory *": "allow", "{env:FACTORY_DEV_GH} pr edit * --repo edoworks/factory *": "allow", "{env:FACTORY_DEV_GH} pr merge * --repo edoworks/factory *": "allow",
      "git commit*--no-verify*": "deny", "git commit*-n*": "deny", "git commit*--amend*": "deny",
      "git reset --hard*": "deny", "git clean -f*": "deny", "git push*": "deny", "git tag*": "deny",
      "git add .": "deny", "git add -A*": "deny", "git add --all*": "deny", "git add -u*": "deny", "git add --update*": "deny", "git add --pathspec-from-file*": "deny", "git add -*": "deny", "git add --*": "deny",
      "gh issue create*": "deny", "gh issue comment*": "deny", "gh issue close*": "deny",
      "open https://github.com/edoworks/factory/*": "ask",
      "gh issue create --repo edoworks/factory *--repo*": "deny", "gh issue comment --repo edoworks/factory *--repo*": "deny", "gh issue close --repo edoworks/factory *--repo*": "deny",
      "gh issue create --repo edoworks/factory *-R*": "deny", "gh issue comment --repo edoworks/factory *-R*": "deny", "gh issue close --repo edoworks/factory *-R*": "deny",
      "{env:FACTORY_DEV_GH} issue * --repo edoworks/factory *--repo*": "deny", "{env:FACTORY_DEV_GH} issue * --repo edoworks/factory *-R*": "deny",
      "{env:FACTORY_DEV_GH} issue *https://*": "deny", "{env:FACTORY_DEV_GH} issue *http://*": "deny",
      "{env:FACTORY_DEV_GH} pr * --repo edoworks/factory *--repo*": "deny", "{env:FACTORY_DEV_GH} pr * --repo edoworks/factory *-R*": "deny",
      "{env:FACTORY_DEV_GH} pr *https://*": "deny", "{env:FACTORY_DEV_GH} pr *http://*": "deny",
      "open https://github.com/edoworks/factory/* *": "deny",
      "{env:FACTORY_DEV_GH} pr merge*--admin*": "deny", "{env:FACTORY_DEV_GH} repo *": "deny", "{env:FACTORY_DEV_GH} api *": "deny", "{env:FACTORY_DEV_GH} api --hostname github.com user --jq .login": "allow",
      "*;*": "deny", "*&&*": "deny", "*||*": "deny", "*|*": "deny", "*\n*": "deny"
    }
  }
}
