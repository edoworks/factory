#!/usr/bin/env bash
set -euo pipefail

# factory doctor — verify toolchain readiness
# Exits 0 if all checks pass, 1 if any fail.
# Produces a JSON evidence receipt on stdout.

PASS=0
FAIL=0
CHECKS=()
FACTORY_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GIB=$((1024 * 1024 * 1024))
VERIFY_MAX_GIB="${FACTORY_VERIFY_MAX_GIB:-8}"
RECOVERY_FLOOR_GIB="${FACTORY_RECOVERY_FLOOR_GIB:-10}"

check() {
  local name="$1"
  local result="$2"
  local detail="${3:-}"
  if [ "$result" = "pass" ]; then
    CHECKS+=("{\"name\":\"$name\",\"status\":\"pass\",\"detail\":\"$detail\"}")
    PASS=$((PASS + 1))
  else
    CHECKS+=("{\"name\":\"$name\",\"status\":\"fail\",\"detail\":\"$detail\"}")
    FAIL=$((FAIL + 1))
  fi
}

# Xcode
if command -v xcodebuild >/dev/null 2>&1; then
  XCODE_OUTPUT=$(xcodebuild -version 2>/dev/null || true)
  XCODE_LINE=${XCODE_OUTPUT%%$'\n'*}
  XCODE_VERSION=${XCODE_LINE#Xcode }
  check "xcode" "pass" "Xcode $XCODE_VERSION"
else
  check "xcode" "fail" "Xcode not found"
fi

# Swift
if command -v swift >/dev/null 2>&1; then
  SWIFT_OUTPUT=$(swift --version 2>/dev/null || true)
  SWIFT_VERSION=${SWIFT_OUTPUT%%$'\n'*}
  check "swift" "pass" "$SWIFT_VERSION"
else
  check "swift" "fail" "Swift not found"
fi

# Git
if command -v git >/dev/null 2>&1; then
  GIT_VERSION=$(git --version 2>/dev/null)
  check "git" "pass" "$GIT_VERSION"
else
  check "git" "fail" "Git not found"
fi

# xcodegen (optional, used by bootstrap)
if command -v xcodegen >/dev/null 2>&1; then
  check "xcodegen" "pass" "xcodegen available"
else
  check "xcodegen" "warn" "xcodegen not found (required for factory init)"
fi

# Simulators
if [ "$PASS" -gt 0 ] && command -v xcrun >/dev/null 2>&1; then
  SIM_COUNT=$(xcrun simctl list devices available 2>/dev/null | grep -c "(" || true)
  if [ "$SIM_COUNT" -gt 0 ]; then
    check "simulators" "pass" "$SIM_COUNT available simulators"
  else
    check "simulators" "fail" "No available simulators"
  fi
else
  check "simulators" "fail" "Cannot list simulators"
fi

# Storage admission for the default verification workload. The 8 GiB workload
# reserve is based on the observed 2.4 GiB single-destination XCTest peak plus
# build/archive margin; both values remain configurable while qualification
# collects representative peaks.
STORAGE_RECEIPT='{"schema_version":1,"decision":"BLOCKED","error":"storage preflight unavailable"}'
if STORAGE_RECEIPT=$(python3 "$FACTORY_ROOT/scripts/factory_storage.py" inspect \
  --path / \
  --reserve-bytes "$((VERIFY_MAX_GIB * GIB))" \
  --recovery-floor-bytes "$((RECOVERY_FLOOR_GIB * GIB))"); then
  check "storage_admission" "pass" "${VERIFY_MAX_GIB} GiB workload reserve above ${RECOVERY_FLOOR_GIB} GiB recovery floor"
else
  if [ -z "$STORAGE_RECEIPT" ]; then
    STORAGE_RECEIPT='{"schema_version":1,"decision":"BLOCKED","error":"storage preflight unavailable"}'
  fi
  check "storage_admission" "fail" "Default verification workload cannot be reserved safely"
fi

# Output JSON evidence
echo "{"
echo "  \"schema_version\": 1,"
echo "  \"command\": \"factory doctor\","
echo "  \"timestamp\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
echo "  \"passed\": $PASS,"
echo "  \"failed\": $FAIL,"
echo "  \"storage\": $STORAGE_RECEIPT,"
echo "  \"checks\": ["
for i in "${!CHECKS[@]}"; do
  if [ "$i" -lt $((${#CHECKS[@]} - 1)) ]; then
    echo "    ${CHECKS[$i]},"
  else
    echo "    ${CHECKS[$i]}"
  fi
done
echo "  ]"
echo "}"

if [ "$FAIL" -gt 0 ]; then
  exit 1
fi
